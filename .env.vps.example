# ==============================================================================
# .env cho môi trường VPS (eBay Clone Admin Role)
# Đặt file này tại: /opt/ebay-admin/.env
# ==============================================================================

# ---- SQL Server 2022 ----
# Bắt buộc: >= 8 ký tự, có chữ hoa, thường, số và ký tự đặc biệt (!@#$...)
SA_PASSWORD=YourStrongVpsPassword2026!

# ---- JWT Secret Key ----
# Ít nhất 32 ký tự ngẫu nhiên
JWT_KEY=YourSuperSecretJwtKeyAtLeast32CharactersForVpsProduction!

# ---- W7-01: Persistent 32-byte Base64 Encryption Key ----
# Sinh nhanh trên PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Hoặc trên Linux: openssl rand -base64 32
ENCRYPTION_KEY=Your32ByteBase64GeneratedKeyHere=
LEGACY_ENCRYPTION_KEY=

# ---- Email Settings (Gmail SMTP / SendGrid) ----
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ---- ASP.NET Core Runtime & Database Initialization ----
ASPNETCORE_ENVIRONMENT=Production
# Tự động chạy Migration khi DB mới tạo lần đầu trên VPS (true/false)
RUN_MIGRATIONS=true
# Chế độ seed dữ liệu ban đầu trên VPS: "System" (seed roles & permissions), "None" (không seed)
SEEDING_MODE=System

# ---- Security & Whitelist IP cho InternalIpMiddleware ----
# Trên VPS, đặt "*" để cho phép truy cập qua Internet & Reverse Proxy:
INTERNAL_IPS_ALLOW=*

# ---- Container Image ----
WEB_IMAGE=ghcr.io/monomee/ebay_clone_adminrole:latest
