# ==============================================================================
# .env cho môi trường VPS (eBay Clone Admin Role)
# Đặt file này tại: /opt/ebay-admin/.env
# ==============================================================================

# ---- SQL Server 2022 ----
# Bắt buộc: >= 8 ký tự, có chữ hoa, thường, số và ký tự đặc biệt (!@#$...)
SA_PASSWORD=YourStrongVpsPassword2026!

# ---- JWT Secret Key ----
# Ít nhất 32 ký tự ngẫu nhiên
JWT_KEY=YourSuperSecretJwtKeyAtLeast32CharactersForVpsProduction!

# ---- W7-01: Persistent 32-byte Base64 Encryption Key ----
# Sinh nhanh trên PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Hoặc trên Linux: openssl rand -base64 32
ENCRYPTION_KEY=Your32ByteBase64GeneratedKeyHere=
LEGACY_ENCRYPTION_KEY=

# ---- Email Settings (Gmail SMTP / SendGrid) ----
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ---- Cloudflare Turnstile (captcha trang /register) ----
# Lấy ở Cloudflare dashboard > Turnstile > widget (hostname phải có ebay.petlify.xyz)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- ASP.NET Core Runtime & Database Initialization ----
# LƯU Ý QUAN TRỌNG KHI KHỞI TẠO DB LẦN ĐẦU ĐỂ DEMO ĐỒ ÁN:
# - Đặt ASPNETCORE_ENVIRONMENT=Development và SEEDING_MODE=Demo ở lần chạy đầu tiên
#   để hệ thống tự động tạo đầy đủ tài khoản Admin (superadmin@ebay.com...) và dữ liệu mẫu.
# - Sau khi DB đã có dữ liệu, bạn có thể đổi về ASPNETCORE_ENVIRONMENT=Production và SEEDING_MODE=None.
ASPNETCORE_ENVIRONMENT=Development
# Tự động chạy Migration khi DB mới tạo lần đầu trên VPS (true/false)
RUN_MIGRATIONS=true
# Chế độ seed dữ liệu: "Demo" (chỉ chạy khi Development, nạp full tài khoản + dữ liệu mẫu), "System" (chỉ nạp tên Role, không tạo user), "None"
SEEDING_MODE=Demo
# Bật giao diện Swagger tại /api (true/false)
ENABLE_SWAGGER=true

# ---- Security & Whitelist IP cho InternalIpMiddleware ----
# InternalIpMiddleware kiểm tra theo chuẩn CIDR (IPNetwork.TryParse). Đặt "0.0.0.0/0" để cho phép mọi IPv4 qua Internet:
INTERNAL_IPS_ALLOW=0.0.0.0/0

# ---- Container Image ----
WEB_IMAGE=ghcr.io/monomee/ebay_clone_adminrole:latest
